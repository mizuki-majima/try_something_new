{
  "name": "thirty-days",
  "private": true,
  "type": "module",
  "description": "30日だけ — 新しいことを30日だけ試すためのWebサービス",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "infra"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test:e2e": "playwright test",
    "synth": "npm run build && npm run synth -w infra",
    "deploy": "npm run build && npm run deploy -w infra"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
